#!/usr/bin/env python3
"""兆华工作伙伴加人：每人一把 magpie 钥匙、一个容器、一行名单。不打印钥匙。
  partner-user add <代号> <姓名> <飞书 union_id>   建钥匙（已有就沿用）、建并启动容器、写进名单
  partner-user list                              列出名单和容器状态
  partner-user upgrade [代号…]                   用当前镜像重建容器（默认全部；数据和钥匙不动）
AI工作台群成员可在网页上自助开通，本命令只用于给群外的人开通。"""
import base64, hashlib, hmac, json, os, re, subprocess, sys, time, secrets
from pathlib import Path

# 部署参数与 compose 共用 crysound/web/.env；环境变量里已有的优先。
ENV_FILE = Path(__file__).resolve().parent.parent / '.env'
if ENV_FILE.exists():
    for line in ENV_FILE.read_text().splitlines():
        key, sep, value = line.partition('=')
        if sep and not key.lstrip().startswith('#'):
            os.environ.setdefault(key.strip(), value.strip())
for key in ('PARTNER_DATA', 'PARTNER_SECURE', 'PUBLIC_HOST', 'PARTNER_CONFIG', 'MAGPIE_BASE_URL'):
    if not os.environ.get(key):
        sys.exit(f'在 {ENV_FILE} 设置 {key}')
ROOT = Path(os.environ['PARTNER_DATA'])
SECURE = Path(os.environ['PARTNER_SECURE'])
CONFIG = Path(os.environ['PARTNER_CONFIG'])
USERS = ROOT / 'users.json'
IMAGE = os.environ.get('PARTNER_IMAGE', 'zhaohua-partner:0.2.2-rc.1')
IA = os.environ.get('INFISICAL_ADMIN', '')


def sh(*a, **k):
    return subprocess.run(a, capture_output=True, text=True, **k)


def magpie_key(slug):
    path = SECURE / f'magpie-{slug}.key'
    if path.exists():
        return path
    if os.environ.get('MAGPIE_KEYS') == 'pool':  # magpie 不在本机：领一把预建的钥匙（与网关自助开通同一个池）
        pool = SECURE / 'magpie-pool'
        spare = next(iter(sorted(pool.glob('*.key'))), None)
        if spare is None:
            sys.exit('预建的 magpie 钥匙用完了')
        spare.rename(path); os.chown(path, 1001, 1001)
        with open(pool / 'assigned.log', 'a') as f:
            f.write(f'{spare.name} {slug} cli\n')
        return path
    name = f'zhaohua-partner-{slug}'
    out = sh('docker', 'exec', 'magpie', '/magpie', 'gateway-key', 'add', name).stdout
    key = re.findall(r'sk-magpie-key-[A-Za-z0-9_-]+', out)
    if not key:
        sys.exit(f'magpie 没有返回钥匙：{name}')
    path.write_text(key[0]); path.chmod(0o400)
    if IA: sh('python3', IA, 'put', 'xiaoman', '/zhaohua-partner', f'MAGPIE_KEY_{slug.upper().replace("-", "_")}',
              '--comment', f'兆华工作伙伴 {slug} 容器的 magpie 网关钥匙', input=key[0])
    kid = next(l.split()[0] for l in sh('docker', 'exec', 'magpie', '/magpie', 'gateway-key', 'list').stdout.splitlines() if f' {name} ' in l)
    sh('docker', 'exec', 'magpie', '/magpie', 'gateway-key', 'models', kid, 'codex/*', 'deepseek/*')
    return path


def market_token(slug, union_id):
    key = (SECURE / 'gateway-session.key').read_text().strip().encode()
    enc = lambda value: base64.urlsafe_b64encode(value).rstrip(b'=')
    data = enc(json.dumps({'u': union_id, 'e': int(time.time()) + 180 * 86400}).encode())
    mac = enc(hmac.new(key, b'zpd.' + data, hashlib.sha256).digest())
    directory = ROOT / 'users' / slug
    directory.mkdir(parents=True, exist_ok=True)
    os.chown(directory, 1001, 1001)
    target = directory / '.zp-market-token'
    temp = directory / ('.zp-market-token.' + secrets.token_hex(12))
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, 'wb') as out:
        out.write(b'zpd.' + data + b'.' + mac + b'\n')
    temp.chmod(0o600); os.chown(temp, 1001, 1001); temp.replace(target)


def require_config():
    for file in ('plugins.json', 'partner.patch.yml', 'profile-upgrades.mjs', 'plugin-patches.mjs', 'market-profile.mjs', 'market-npmrc.mjs', 'skills/publish-zhaohua-market/SKILL.md'):
        if not (CONFIG / file).is_file():
            sys.exit(f'公司配置缺失：{CONFIG / file}；请先同步服务器配置目录')


def container(slug, key):
    require_config()
    name = f'zhaohua-partner-{slug}'
    if sh('docker', 'inspect', name).returncode == 0:
        sh('docker', 'start', name); return
    data = ROOT / 'users' / slug
    data.mkdir(parents=True, exist_ok=True)
    r = sh('docker', 'run', '-d', '--name', name, '--network', 'partner-net', '--restart', 'unless-stopped',
           '--user', '1001:1001', '-e', f"PUBLIC_HOST={os.environ['PUBLIC_HOST']}",
           '-e', f"MAGPIE_BASE_URL={os.environ['MAGPIE_BASE_URL']}",
           '-e', f"MEEGLE_HOST={os.environ.get('MEEGLE_HOST', '')}",
           '--mount', f'type=bind,src={CONFIG},dst=/opt/partner-config,readonly',
           '-v', f'{data}:/data', '-v', f'{key}:/etc/partner/magpie.key:ro',
           '--memory', '2g', '--cpus', '2', '--pids-limit', '512',
           '--label', f'zhaohua-partner.user={slug}', IMAGE)
    if r.returncode:
        sys.exit(r.stderr.strip())


def main():
    users = json.loads(USERS.read_text()) if USERS.exists() else []
    if sys.argv[1:2] == ['list']:
        for u in users:
            st = sh('docker', 'inspect', '-f', '{{.State.Status}}', f'zhaohua-partner-{u["slug"]}').stdout.strip() or '无容器'
            print(u['slug'], u['name'], u.get('unionId', '-'), st)
        return
    if sys.argv[1:2] == ['upgrade']:
        require_config()
        for u in users:
            if sys.argv[2:] and u['slug'] not in sys.argv[2:]:
                continue
            sh('docker', 'rm', '-f', f'zhaohua-partner-{u["slug"]}')
            market_token(u['slug'], u['unionId'])
            container(u['slug'], SECURE / f'magpie-{u["slug"]}.key')
            print('已升级', u['slug'])
        return
    if sys.argv[1:2] != ['add'] or len(sys.argv) != 5:
        sys.exit(__doc__)
    slug, name, union_id = sys.argv[2], sys.argv[3], sys.argv[4].strip()
    if not re.fullmatch(r'[a-z][a-z0-9-]{1,30}', slug):
        sys.exit('代号只用小写字母、数字和短横线')
    require_config()
    key = magpie_key(slug)
    market_token(slug, union_id)
    container(slug, key)
    old = next((u for u in users if u['slug'] == slug), {})
    users = [u for u in users if u['slug'] != slug] + [{**old, 'slug': slug, 'name': name, 'unionId': union_id}]
    with open(USERS, 'r+') as f:  # 原地改写：网关以单文件挂载它，换 inode 会让网关看不到新内容
        f.seek(0); f.write(json.dumps(users, ensure_ascii=False, indent=1)); f.truncate()
    USERS.chmod(0o644)
    print(f'已开通 {name}（{slug}）')


if __name__ == '__main__':
    main()
