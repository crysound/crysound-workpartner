# 复制成同目录的 .env 再填；compose.yml 与 bin/ 下的脚本都读它。
# 桌面打包前 configure-public-host.mjs 只提取 PUBLIC_HOST；CI 仓库变量 PUBLIC_HOST 与此同步。
PUBLIC_HOST=partner.example.com
# 可选：换过网址时填旧网址（逗号分隔）。已装的桌面版仍可按旧网址登录、调模型，其余访问跳到 PUBLIC_HOST；飞书应用的重定向地址里两个网址都要登记
OLD_HOSTS=
PARTNER_DATA=/srv/partner/data
PARTNER_SECURE=/srv/partner/secure
# 飞书自建应用的 App ID；App Secret 放在 PARTNER_SECURE/feishu-app.secret
PARTNER_FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
# 这个飞书群的成员可自助开通
PILOT_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# exec：在本机 magpie 容器里建钥匙；pool：从 PARTNER_SECURE/magpie-pool 领预建的钥匙
MAGPIE_KEYS=exec
# 可选：partner-user 用它把新钥匙存进 Infisical
INFISICAL_ADMIN=

# 市场审批管理员，必填已开通用户的 slug，首期填写 Jason 的 slug，多个用逗号分隔。
MARKET_ADMINS=
# 部署前由管理员在 PARTNER_SECURE 准备（不要把值写进 .env）：
# market-npm-auth：单行 zp-gateway:<内部密码>，网关读取，root:root 600。
# market-htpasswd：同一账号/密码的 htpasswd（bcrypt），Verdaccio 读取，10001:65533 400。
# 禁止把内部账号发给用户；生成步骤与数据目录权限见 market/README.md。
