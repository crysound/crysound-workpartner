  "license": "MIT",
  "engines": { "node": ">=24.9.0", "dsh": ">=0.2.2-rc.1" },
  "peerDependencies": { "@deepseek-ai/cordis": ">=4.0.0", "@deepseek-ai/dsh-tools": "0.2.2-rc.1", "@deepseek-ai/schemastery": "*" },
  "scripts": { "test": "node --test tests/*.test.mjs" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-tool"] }
