[
  {"name":"list_folders","description":"列出这台电脑已授权的文件夹及只读状态；默认没有授权。","confirm":false,"inputSchema":{"type":"object","properties":{},"additionalProperties":false}},
  {"name":"list_dir","description":"列出授权文件夹内的目录项，跳过链接和密钥、浏览器配置等敏感目录；最多返回 500 项。","confirm":false,"inputSchema":{"type":"object","properties":{"path":{"type":"string","minLength":1,"maxLength":4096}},"required":["path"],"additionalProperties":false}},
  {"name":"search","description":"在授权文件夹内按文件名或 UTF-8 文本内容搜索。跳过敏感目录和链接；最多检查 2000 项、读取 20 MB、返回 100 项；单文件文本不超过 1 MB。结果含是否截断。","confirm":false,"inputSchema":{"type":"object","properties":{"path":{"type":"string","minLength":1,"maxLength":4096},"query":{"type":"string","minLength":1,"maxLength":200},"mode":{"type":"string","enum":["name","text","both"]}},"required":["path","query"],"additionalProperties":false}},
  {"name":"read_text","description":"读取授权范围内的 UTF-8 文本，最多 1 MB；Word、Excel、PDF 请先取到云端再处理。","confirm":false,"inputSchema":{"type":"object","properties":{"path":{"type":"string","minLength":1,"maxLength":4096}},"required":["path"],"additionalProperties":false}},
  {"name":"fetch_to_cloud","description":"把本机已授权的单个文件复制到云端 /data/work/来自本机/，最多 200 MB。返回云端路径；不会覆盖已有文件。","confirm":false,"inputSchema":{"type":"object","properties":{"path":{"type":"string","minLength":1,"maxLength":4096}},"required":["path"],"additionalProperties":false}},
  {"name":"save_to_laptop","description":"把云端 /data 下的单个文件存回本机可写授权目录，最多 200 MB；需要同事在电脑上确认，可能覆盖目标文件。","confirm":true,"inputSchema":{"type":"object","properties":{"cloud_path":{"type":"string","minLength":1,"maxLength":4096},"path":{"type":"string","minLength":1,"maxLength":4096},"summary":{"type":"string","minLength":1,"maxLength":500}},"required":["cloud_path","path","summary"],"additionalProperties":false}},
  {"name":"write_text","description":"在本机可写授权目录新建或替换 UTF-8 文本，最多 1 MB。需要同事确认，summary 必须说明改动。","confirm":true,"inputSchema":{"type":"object","properties":{"path":{"type":"string","minLength":1,"maxLength":4096},"text":{"type":"string","maxLength":1048576},"summary":{"type":"string","minLength":1,"maxLength":500}},"required":["path","text","summary"],"additionalProperties":false}},
  {"name":"move","description":"移动或改名单个本机文件，源和目标都须在可写授权目录内；不覆盖已有目标，需要同事确认。","confirm":true,"inputSchema":{"type":"object","properties":{"path":{"type":"string","minLength":1,"maxLength":4096},"destination":{"type":"string","minLength":1,"maxLength":4096},"summary":{"type":"string","minLength":1,"maxLength":500}},"required":["path","destination","summary"],"additionalProperties":false}},
  {"name":"delete","description":"把单个本机文件放进操作系统废纸篓，不永久删除；须在可写授权目录内并经同事确认。","confirm":true,"inputSchema":{"type":"object","properties":{"path":{"type":"string","minLength":1,"maxLength":4096},"summary":{"type":"string","minLength":1,"maxLength":500}},"required":["path","summary"],"additionalProperties":false}},
  {"name":"open","description":"用本机默认应用打开已授权的普通文件；拒绝脚本、程序、快捷方式和可执行文件，不运行命令。","confirm":false,"inputSchema":{"type":"object","properties":{"path":{"type":"string","minLength":1,"maxLength":4096}},"required":["path"],"additionalProperties":false}}
